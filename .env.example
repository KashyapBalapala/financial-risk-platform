# Local-only connection matching compose.yaml.
DATABASE_URL=postgresql://risk_app:local_dev_only@localhost:5433/risk_platform

# Must match the origin used by `npm run dev`.
BETTER_AUTH_URL=http://localhost:3002

# Generate each secret independently with `openssl rand -hex 32`.
# Paste the generated values below; do not commit them.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
TRANSACTION_INGESTION_TOKEN=replace-with-output-from-openssl-rand-hex-32
